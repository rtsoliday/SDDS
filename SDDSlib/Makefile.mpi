ENABLE_OPENMP := 1
BUNDLE_OPENMP := 1
include ../Makefile.rules

LIBRARY = SDDS1mpi

LIBRARY_SRC = SDDS_ascii.mpi.c \
          SDDS_enum.mpi.c \
          SDDS_copy.mpi.c \
          SDDS_data.mpi.c \
          SDDS_dataprep.mpi.c \
          SDDS_extract.mpi.c \
          SDDS_info.mpi.c \
          SDDS_lzma.mpi.c \
          SDDS_mplsupport.mpi.c \
          SDDS_process.mpi.c \
          SDDS_rpn.mpi.c \
          SDDS_transfer.mpi.c \
          SDDS_utils.mpi.c \
          SDDS_write.mpi.c \
          SDDS_MPI_binary.c \
          SDDSmpi_input.c \
          SDDSmpi_enum.c \
          SDDSmpi_output.c \
          SDDS_binary.mpi.c \
          SDDS_input.mpi.c \
          SDDS_output.mpi.c

CFLAGS += -DzLib -DALLOW_FILE_LOCKING=1 -DRPN_SUPPORT -DUSE_MPI=1 -DSDDS_MPI_IO=1 -DMASTER_READTITLE_ONLY -I../include

ifeq ($(OS), Linux)
  CC = $(MPI_CC)
endif

ifeq ($(OS), Darwin)
  CC = $(MPI_CC)
endif

ifeq ($(OS), Windows)
  CFLAGS += -I../zlib -I../lzma $(WIN_MPI_INC) -DEXPORT_SDDS /wd4244 /wd4267
  LIBRARY_LIBS = rpnlib.lib mdbmth.lib mdblib.lib lzma.lib z.lib
  LIBRARY_SYS_LIBS = $(WIN_MPI_LIB)
endif

include ../Makefile.build

# Match the shared compile rule, including header dependency tracking.
$(OBJ_DIR)/%.mpi.$(OBJEXT): %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(EXTRA_CFLAGS) $(DEPFLAGS) $(if $(filter $(notdir $<), $(LIBRARY_SRC)),$(LIBRARY_CFLAGS)) -c $< $(OUTPUT)

MPI_ENUM_TEST = $(OBJ_DIR)/test_sdds_enum_mpi$(EXEEXT)
MPIEXEC ?= $(dir $(lastword $(MPI_CC)))mpiexec
# Link the archive built here, not a previously installed copy.
ifeq ($(OS), Windows)
MPI_ENUM_LIBS = $(LIBRARY) $(LIB_DIR)/rpnlib.lib $(LIB_DIR)/mdbmth.lib $(LIB_DIR)/mdblib.lib $(LIBRARY_LIBS) $(WIN_MPI_LIB)
MPI_ENUM_OUTPUT = /Fe$@
else
MPI_ENUM_LIBS = $(LIBRARY) -L$(LIB_DIR) -lrpnlib -lmdbmth -lmdblib $(LZMA_LIB) $(GSL_LIB) $(GSLCBLAS_LIB) $(Z_LIB) -lm
MPI_ENUM_OUTPUT = -o $@
endif

$(MPI_ENUM_TEST): test_sdds_enum_mpi.c $(LIBRARY)
	$(CC) $(CFLAGS) $(MPI_ENUM_OUTPUT) test_sdds_enum_mpi.c $(MPI_ENUM_LIBS)

.PHONY: enum-test
enum-test: $(MPI_ENUM_TEST) install-libraries
	mkdir -p $(OBJ_DIR)/test-artifacts/enum-mpi
	$(MPIEXEC) -n 2 $(MPI_ENUM_TEST) $(OBJ_DIR)/test-artifacts/enum-mpi
